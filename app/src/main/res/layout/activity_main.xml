<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F7F8FA">
 <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="Контроль расходов" android:textSize="28sp" android:textStyle="bold"/>
 <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:padding="6dp" android:orientation="horizontal" android:background="#FFFFFF">
  <Button android:id="@+id/expenses" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Расходы" android:textAllCaps="false"/>
  <Button android:id="@+id/projects" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Проекты" android:textAllCaps="false"/>
  <Button android:id="@+id/reports" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Отчёты" android:textAllCaps="false"/>
 </LinearLayout>
</LinearLayout>